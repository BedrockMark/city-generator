references/*.png

# Screenshots in version reports stay local; only the README figures and the analysis figures are tracked
docs/**/*.png
docs/**/*.gif
!docs/readme/*.png
!docs/reports/fig/*.png
!docs/_prev/fig/anti_crop.png

